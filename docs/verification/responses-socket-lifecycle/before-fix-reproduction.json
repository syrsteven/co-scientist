{
  "scope": "GET only, no credentials, no model execution, no DB access",
  "proxy": {
    "effective_proxies": {
      "http": {
        "scheme": "http",
        "host": "127.0.0.1",
        "port": 7897,
        "credentials_present": false
      },
      "https": {
        "scheme": "http",
        "host": "127.0.0.1",
        "port": 7897,
        "credentials_present": false
      }
    },
