a2e08d85b\"\n      ],\n      \"context_transfer\": \"\u6765\u6e90\u7684\u86cb\u767d\u8017\u51cf\u3001\u901a\u8def\u6291\u5236\u548c\u4f4d\u70b9\u66ff\u6362\u4e0d\u81ea\u52a8\u6784\u6210\u4fee\u9970\u9009\u62e9\u6027\u5e72\u9884\uff1b\u78f7\u9178\u6a21\u62df\u4e5f\u4e0d\u7b49\u4e8e\u771f\u5b9e\u78f7\u9178\u5316\u3002\",\n      \"possible_check\": \"\u5148\u9a8c\u8bc1\u5e72\u9884\u786e\u5b9e\u6539\u53d8\u5df2\u9274\u5b9a\u4fee\u9970\u4e14\u672a\u76f4\u63a5\u6539\u53d8\u86cb\u767d\u91cf\u6216\u5b9a\u4f4d\uff0c\u518d\u4ee5\u72ec\u7acb\u65b9\u5f0f\u6838\u5bf9\u6548\u5e94\uff1b\u82e5\u4f7f\u7528\u66ff\u6362\u4f53\uff0c\u5e94\u6838\u67e5\u8868\u8fbe\u3001\u7ed3\u6784\u53ca\u771f\u5b9e\u4fee\u9970\u7684\u4e00\u81f4\u6027\u3002\"\n    },\n    {\n      \"assumption\": \"\u4fee\u9970\u548c\u8f93\u51fa\u53d8\u5316\u53d1\u751f\u4e8e\u635f\u4f24\u4e4b\u524d\uff0c\u5e76\u975e\u635f\u4f24\u6216\u5171\u540c\u4e0a\u6e38\u5e94\u6fc0\u9020\u6210\u7684\u65e0\u529f\u80fd\u4f34\u968f\u53d8\u5316\u3002\",\n      \"source_view_refs\": [\n        \"75bf96a0e25b4e6aa10e54f6781a5382\",\n        \"ef0d631b44e14b2abf8f10443c55d5c2\"\n      ],\n      \"context_transfer\": \"\u73b0\u6709\u6765\u6e90\u6ca1\u6709\u63d0\u4f9b\u4fee\u9970\u3001mRNA \u8f93\u51fa\u548c\u635f\u4f24\u7684\u5171\u540c\u65f6\u95f4\u5e8f\u5217\uff1bSOD1 \u964d\u4f4e\u540e\u7684 XPO1 \u5b9a\u4f4d\u6062\u590d\u4e0d\u80fd\u5efa\u7acb\u8be5\u65f6\u5e8f\u3002\",\n      \"possible_check\": \"\u5728\u53ef\u6bd4\u8f83\u7ec6\u80de\u7fa4\u4e2d\u540c\u6b65\u5b89\u6392\u4fee\u9970\u3001\u8f93\u51fa\u548c\u591a\u7ef4\u635f\u4f24\u6d4b\u91cf\uff0c\u5e76\u5728\u635f\u4f24\u524d\u8fdb\u884c\u9009\u62e9\u6027\u7ea0\u6b63\uff0c\u6bd4\u8f83\u51fa\u73b0\u548c\u6062\u590d\u987a\u5e8f\u3002\"\n    },\n    {\n      \"assumption\": \"\u8f93\u51fa\u969c\u788d\u5bf9\u540e\u7eed\u635f\u4f24\u5177\u6709\u53ef\u5206\u79bb\u7684\u8d21\u732e\uff0c\u800c\u4e0d\u53ea\u662f\u4e00\u4e2a\u4f34\u968f\u7ec8\u70b9\u3002\",\n      \"source_view_refs\": [\n        \"75bf96a0e25b4e6aa10e54f6781a5382\",\n        \"876e76bb00f84e928a89cbea813dacad\"\n      ],\n      \"context_transfer\": \"ANXA11 \u6765\u6e90\u63d0\u4f9b\u5173\u8054\u800c\u975e\u4e2d\u4ecb\u56e0\u679c\u8bc1\u636e\uff1bTDP-43 \u7684\u7279\u5b9a\u65e0\u635f\u5bb3\u7ed3\u679c\u65e2\u4e0d\u8bc1\u660e\u4e5f\u4e0d\u5426\u5b9a\u672c\u6865\u6881\u3002\",\n      \"possible_check\": \"\u68c0\u9a8c\u65e9\u671f\u8f93\u51fa\u6539\u5584\u80fd\u5426\u9884\u6d4b\u540e\u7eed\u635f\u4f24\u51cf\u8f7b\uff0c\u5e76\u5728\u6709\u6761\u4ef6\u65f6\u7528\u72ec\u7acb\u7684\u8f93\u51fa\u7ea0\u6b63\u6bd4\u8f83\u6216\u8f93\u51fa\u963b\u65ad\u6bd4\u8f83\u68c0\u9a8c\u4e2d\u4ecb\u5173\u7cfb\uff0c\u540c\u65f6\u6392\u9664\u5e72\u9884\u7684\u76f4\u63a5\u4fdd\u62a4\u4f5c\u7528\u3002\"\n    }\n  ],\n  \"nearest_prior_work_scope\": \"\u5728\u5b9e\u9645\u5df2\u8bfb\u8303\u56f4\u5185\uff0cANXA11 \u8bb0\u5f55\u6700\u63a5\u8fd1\u672c\u5019\u9009\u7684\u75be\u75c5\u76f8\u5173\u7ec8\u70b9\uff0c\u4f46\u53ea\u5efa\u7acb\u805a\u96c6\u4e0e\u6838\u5b54\u5206\u5e03\u3001mRNA \u8f93\u51fa\u53ca\u6bd2\u6027\u7684\u5173\u8054\u3002\u5176\u60a3\u8005\u8111\u5f02\u6e90\u4e1d\u72b6\u7ed3\u6784\u6765\u81ea\u6458\u8981\u5f15\u8ff0\u7684\u65e2\u5f80\u51b7\u51bb\u7535\u955c\u80cc\u666f\uff1bANXA11 \u76f8\u53d8\u5b9e\u9a8c\u7684\u5177\u4f53\u4f53\u7cfb\u672a\u660e\u786e\uff1b\u4eba iPSC \u6765\u6e90\u795e\u7ecf\u5143\u7684\u64ad\u79cd\u4f20\u64ad\u4e0e Highlights \u4e2d SH-SY5Y \u7684\u540c\u578b\u64ad\u79cd\u4f20\u64ad\u987b\u5206\u522b\u4fdd\u7559\uff0c\u4e0d\u80fd\u5c06\u795e\u7ecf\u5143\u7684\u5176\u4ed6\u7ec8\u70b9\u8d4b\u7ed9 SH-SY5Y\u3002TDP-43 \u75c5\u7406\u8f6c\u5316\u548c TurboID \u5b9e\u9a8c\u7684\u5177\u4f53\u4f53\u7cfb\u4ea6\u672a\u660e\u786e\u3002\\nSOD1 \u6458\u8981\u62a5\u544a\u6838\u8f93\u5165\u3001\u6838\u8f93\u51fa\u53d7\u6270\u53ca RanGAP1\u3001XPO1 \u80de\u8d28\u79ef\u7d2f\uff0c\u4f46\u672a\u9010\u9879\u5bf9\u5e94\u6a21\u578b\uff0c\u4e5f\u672a\u660e\u786e\u662f\u5426\u6d4b\u91cf mRNA \u8f93\u51fa\u3002FG-Nups \u6838\u5b54\u4e30\u5ea6\u964d\u4f4e\u4e0e\u6838\u5706\u5ea6\u4e0d\u53d8\u987b\u540c\u65f6\u4fdd\u7559\u3002Iba1 \u9633\u6027\u5c0f\u80f6\u8d28\u7ec6\u80de\u7684\u5f02\u5e38\u79ef\u7d2f\u89c2\u5bdf\u672a\u660e\u786e\u6750\u6599\u6765\u6e90\uff1b\u4f5c\u8005\u7684\u975e\u7ec6\u80de\u81ea\u4e3b\u6027\u89e3\u91ca\u5e76\u975e\u5df2\u5206\u79bb\u7684\u673a\u5236\u3002\u8f6c\u57fa\u56e0\u5c0f\u9f20 AAV \u964d\u4f4e\u7a81\u53d8 SOD1 \u540e\u6062\u590d\u7684\u662f XPO1 \u6838\u5185\u5b9a\u4f4d\u3002\u60a3\u8005\u6765\u6e90\u6210\u7ea4\u7ef4\u7ec6\u80de\u548c SOD1-ALS \u5c38\u68c0\u810a\u9ad3\u7ec4\u7ec7\u5206\u522b\u62a5\u544a\u53ef\u6bd4\u8fd0\u8f93\u6270\u52a8\uff0c\u4f46\u5404\u81ea\u590d\u73b0\u7684\u5177\u4f53\u7ec8\u70b9\u672a\u8bf4\u660e\uff0c\u4e0d\u80fd\u62fc\u6210\u7edf\u4e00\u65f6\u95f4\u94fe\u3002\\nTPR \u6458\u8981\u76f4\u63a5\u63d0\u4f9b\u975e ALS \u60c5\u5883\u7684\u6838\u5b54\u86cb\u767d\u4f4d\u70b9\u78f7\u9178\u5316\u3002EGFR \u6291\u5236\u5242\u3001BRAF \u6291\u5236\u5242\u5206\u522b\u6291\u5236\u8be5\u4fee\u9970\uff0c\u81f4\u764c\u6027 RAS\u3001BRAF \u5206\u522b\u7ec4\u6210\u6027\u8bf1\u5bfc\u8be5\u4fee\u9970\uff0c\u4e0d\u80fd\u5408\u5e76\u4e3a\u8054\u5408\u5904\u7406\u6216\u72ec\u7acb\u91cd\u590d\u3002TPR \u8017\u51cf\u6539\u53d8 EGF \u8bf1\u5bfc\u57fa\u56e0\u8868\u8fbe\u3001\u589e\u5f3a FOS \u8bf1\u5bfc\u5e76\u6539\u53d8\u7ec6\u80de\u5468\u671f\uff0c\u5468\u671f\u53d8\u5316\u65b9\u5411\u672a\u62a5\u544a\uff0c\u4e14\u8fd9\u4e9b\u6548\u5e94\u672a\u88ab\u5f52\u56e0\u4e8e\u8be5\u4f4d\u70b9\u3002Tpr \u5355\u500d\u5242\u91cf\u4e0d\u8db3\u5c0f\u9f20\u7684\u6574\u4f53\u813e\u7ec4\u7ec7 RNA-seq \u4e0e CD3/CD28 \u523a\u6fc0\u813e\u7ec6\u80de Fos \u7ed3\u679c\u4e0d\u540c\u4e8e EGF \u6761\u4ef6\uff1b\u6574\u4f53\u7ec4\u7ec7\u7684\u7ec6\u80de\u7ec4\u6210\u5f71\u54cd\u672a\u89e3\u51b3\u3002\u6d46\u6db2\u6027\u5375\u5de2\u764c\u78f7\u9178\u5316\u5347\u9ad8\u4e0e\u4e09\u9634\u6027\u4e73\u817a\u764c\u78f7\u9178\u5316\u6a21\u5f0f\u5f02\u8d28\u4e5f\u4e0d\u80fd\u5408\u5e76\u4e3a\u7edf\u4e00\u5347\u9ad8\u3002\u4e0a\u8ff0\u7ed3\u679c\u5747\u4e0d\u5efa\u7acb ALS \u6216\u672c\u5019\u9009\u7684\u91ca\u653e\u9636\u6bb5\u673a\u5236\u3002\\nSUN1 \u6458\u8981\u6d89\u53ca\u5185\u6838\u819c/LINC \u86cb\u767d\uff0c\u7ecf NXF1 \u5173\u8054 mRNP\u3001\u7ecf Nup153 \u8054\u7cfb NPC\uff0c\u4f46\u672a\u62a5\u544a Nup153 \u78f7\u9178\u5316\u6216\u5176\u5173\u8054\u53d7 S113 \u8c03\u63a7\u3002PKC \u6761\u4ef6\u4e0b\u7ed3\u5408\u964d\u4f4e\u3001S113A \u5728\u6572\u4f4e\u540e\u8f83\u5f31\u6062\u590d\u3001S113D \u5141\u8bb8\u9ad8\u6548\u8f93\u51fa\u987b\u4fdd\u7559\u5404\u81ea\u6761\u4ef6\uff0c\u4e0d\u80fd\u62fc\u6210\u540c\u4e00\u914d\u5bf9\u5b9e\u9a8c\u3002\u53e6\u6709 Nesprin-2 \u6572\u4f4e\u635f\u5bb3\u8f93\u51fa\uff0c\u4ee5\u53ca\u8868\u8fbe\u4e0d\u80fd\u7ed3\u5408 Nesprin-2 \u7684 SUN \u7ed3\u6784\u57df\u7f3a\u5931 SUN1 \u672a\u5f71\u54cd\u8f93\u51fa\uff1b\u540e\u8005\u4e0d\u7b49\u4e8e\u6062\u590d\u524d\u8005\uff0c\u4e5f\u4e0d\u8bc1\u660e LINC \u6574\u4f53\u65e0\u5173\u3002\\nTDP-43 \u5c40\u90e8\u6b63\u6587\u62a5\u544a\uff1aHeLa \u8017\u51cf\u540e\u91cd\u8868\u8fbe Wt\u300112D\u300112A \u5747\u4e3b\u8981\u6838\u5b9a\u4f4d\uff1b\u6fc0\u7d20\u8bf1\u5bfc\u878d\u5408\u62a5\u544a\u7cfb\u7edf\u7684\u6838\u8f93\u5165\u901f\u7387\u65e0\u53ef\u8fa8\u5dee\u5f02\uff1b\u77ac\u65f6 HeLa \u8868\u8fbe\u5bf9\u5185\u6e90\u86cb\u767d\u4e0b\u8c03\u76f8\u540c\uff1b\u4e24\u79cd\u91cd\u7ec4 RNA \u5e95\u7269\u7ed3\u5408\u53ef\u6bd4\uff1b\u6240\u6d4b SKAR\u3001Bim \u526a\u63a5\u5747\u53ef\u6062\u590d\u3002\u7a33\u5b9a\u8bf1\u5bfc U2OS \u4e2d\u6838\u5b9a\u4f4d\u548c\u81ea\u8c03\u63a7\u4e5f\u4fdd\u7559\uff0c\u4f46\u4e0d\u80fd\u8d4b\u4e88\u5176\u53e6\u4e00\u5b9e\u9a8c\u7684\u8f93\u5165\u52a8\u529b\u5b66\u7ed3\u679c\u6216\u53d8\u4f53\u95f4\u76f8\u540c\u6548\u5e94\u91cf\u3002\u4ee5\u4e0a\u7ed3\u679c\u7ea6\u675f\u6cdb\u5316\uff0c\u4e0d\u8bc1\u660e\u7edf\u8ba1\u7b49\u6548\u6216\u6240\u6709 RNA \u529f\u80fd\u6b63\u5e38\u3002\\n\u8fd9\u4e9b\u662f\u6240\u4f9b\u9605\u8bfb\u4e2d\u7684\u8fd1\u90bb\u8303\u56f4\uff0c\u4e0d\u662f\u7ecf\u7cfb\u7edf\u68c0\u7d22\u786e\u5b9a\u7684\u5168\u7403\u6700\u8fd1\u5de5\u4f5c\uff0c\u4e5f\u4e0d\u662f\u672c\u5019\u9009\u7684\u65b0\u9896\u6027\u8bc1\u660e\u3002\",\n  \"competing_explanations\": [\n    \"\u635f\u4f24\u540e\u53cd\u5e94\uff1a\u7ec6\u80de\u635f\u4f24\u5148\u53d1\u751f\uff0c\u968f\u540e\u6838\u5b54\u86cb\u767d\u78f7\u9178\u5316\u548c RNA \u5206\u5e03\u6539\u53d8\uff1b\u7ea0\u6b63\u4fee\u9970\u5e76\u4e0d\u80fd\u7ea0\u6b63\u65e9\u671f\u8f93\u51fa\u969c\u788d\u3002\",\n    \"\u9002\u5e94\u6027\u53cd\u5e94\uff1a\u78f7\u9178\u5316\u5347\u9ad8\u6709\u52a9\u4e8e\u7ef4\u6301\u8f93\u51fa\u6216\u9650\u5236\u635f\u4f24\uff0c\u9009\u62e9\u6027\u964d\u4f4e\u8be5\u4fee\u9970\u53cd\u800c\u4f7f\u8f93\u51fa\u6216\u635f\u4f24\u6076\u5316\u3002\",\n    \"\u5171\u540c\u4e0a\u6e38\u9a71\u52a8\uff1a\u540c\u4e00\u5e94\u6fc0\u5206\u522b\u5bfc\u81f4\u4fee\u9970\u53d8\u5316\u3001\u8f93\u51fa\u5f02\u5e38\u548c\u635f\u4f24\uff1b\u4fee\u9970\u53ea\u662f\u901a\u8def\u6d3b\u52a8\u6807\u8bb0\uff0c\u4e0d\u5177\u6709\u8f93\u51fa\u529f\u80fd\u3002\",\n    \"\u6838\u5b54\u7ec4\u5206\u6216\u8fd0\u8f93\u56e0\u5b50\u673a\u5236\uff1a\u6838\u5b54\u86cb\u767d\u4e30\u5ea6\u3001\u91cd\u5b9a\u4f4d\u3001\u6838\u819c\u8fc7\u7a0b\u6216\u8fd0\u8f93\u8c03\u8282\u56e0\u5b50\u5b9a\u4f4d\u53d8\u5316\u8db3\u4ee5\u89e3\u91ca\u8868\u578b\uff0c\u4e0d\u4f9d\u8d56\u8be5\u4fee\u9970\u3002\",\n    \"RNA \u751f\u6210\u6216\u7a33\u5b9a\u6027\u673a\u5236\uff1a\u8f6c\u5f55\u3001\u52a0\u5de5\u6216\u964d\u89e3\u6539\u53d8\u9020\u6210\u6838\u5185 RNA \u589e\u52a0\uff0c\u800c\u975e\u6210\u719f mRNP \u5728\u6838\u5b54\u91ca\u653e\u53d7\u963b\u3002\",\n    \"\u540c\u5c5e\u8f93\u51fa\u969c\u788d\u4f46\u9636\u6bb5\u4e0d\u540c\uff1a\u4fee\u9970\u5f71\u54cd\u7684\u662f mRNP \u6210\u719f\u6216\u6838\u5b54\u62db\u52df\uff0c\u800c\u4e0d\u662f\u5df2\u5230\u8fbe\u6838\u5b54\u7684 mRNP \u91ca\u653e\u3002\",\n    \"\u8f93\u51fa\u4e0e\u635f\u4f24\u8131\u8026\uff1a\u4fee\u9970\u786e\u5b9e\u5f71\u54cd\u8f93\u51fa\uff0c\u4f46\u540e\u7eed\u635f\u4f24\u4e3b\u8981\u7531\u5176\u4ed6\u8fc7\u7a0b\u51b3\u5b9a\uff0c\u8f93\u51fa\u5f02\u5e38\u4e0d\u662f\u672c\u60c5\u5883\u4e2d\u7684\u635f\u4f24\u8d21\u732e\u56e0\u7d20\u3002\"\n  ],\n  \"predictions\": [\n    {\n      \"comparison\": \"\u75be\u75c5\u76f8\u5173\u6761\u4ef6\u4e0e\u5339\u914d\u57fa\u7ebf\u6761\u4ef6\u7684\u5171\u540c\u65f6\u95f4\u5e8f\u5217\u6bd4\u8f83\u3002\",\n      \"claim_prediction\": \"\u7ecf\u86cb\u767d\u603b\u91cf\u548c\u5b9a\u4f4d\u6821\u6b63\u540e\uff0c\u6301\u7eed\u78f7\u9178\u5316\u5347\u9ad8\u5148\u4e8e\u6838\u5b54\u505c\u7559\u5ef6\u957f\u53ca\u80de\u8d28\u5230\u8fbe\u901a\u91cf\u4e0b\u964d\uff1b\u8f93\u51fa\u5f02\u5e38\u5148\u4e8e\u591a\u7ef4\u635f\u4f24\u8bfb\u6570\u5f02\u5e38\u3002\",\n      \"alternative_prediction\": \"\u635f\u4f24\u540e\u53cd\u5e94\u89e3\u91ca\u9884\u6d4b\u635f\u4f24\u5148\u51fa\u73b0\uff0c\u4fee\u9970\u968f\u540e\u53d8\u5316\uff1b\u5171\u540c\u4e0a\u6e38\u89e3\u91ca\u5141\u8bb8\u4fee\u9970\u8f83\u65e9\u51fa\u73b0\uff0c\u4f46\u4e0d\u8981\u6c42\u5176\u9009\u62e9\u6027\u7ea0\u6b63\u80fd\u6062\u590d\u8f93\u51fa\u3002\",\n      \"readout\": \"\u771f\u5b9e\u78f7\u9178\u5316\u3001\u76ee\u6807\u86cb\u767d\u603b\u91cf\u53ca\u6838\u5b54\u5b9a\u4f4d\uff1b\u6210\u719f mRNP \u7684\u6838\u5b54\u5230\u8fbe\u3001\u505c\u7559\u548c\u80de\u8d28\u51fa\u73b0\uff1b\u6838\u5185\u5916\u6210\u719f RNA \u5206\u5e03\u53ca\u72ec\u7acb\u635f\u4f24\u6307\u6807\u3002\"\n    },\n    {\n      \"comparison\": \"\u76f8\u540c\u75be\u75c5\u76f8\u5173\u80cc\u666f\u4e0b\uff0c\u635f\u4f24\u524d\u9009\u62e9\u6027\u6062\u590d\u4fee\u9970\u57fa\u7ebf\u72b6\u6001\u4e0e\u5339\u914d\u5047\u5e72\u9884\u6bd4\u8f83\u3002\",\n      \"claim_prediction\": \"\u5728\u76ee\u6807\u86cb\u767d\u91cf\u3001\u5b9a\u4f4d\u548c\u4e0a\u6e38\u75c5\u7406\u5c1a\u672a\u660e\u663e\u6539\u53d8\u65f6\uff0c\u6838\u5b54\u505c\u7559\u7f29\u77ed\u3001\u6210\u719f RNA \u80de\u8d28\u5230\u8fbe\u901a\u91cf\u63d0\u9ad8\uff0c\u968f\u540e\u6838\u5185\u6ede\u7559\u51cf\u8f7b\u3002\",\n      \"alternative_prediction\": \"\u5171\u540c\u4e0a\u6e38\u6807\u8bb0\u6216\u6838\u5b54\u7ec4\u5206\u4e22\u5931\u89e3\u91ca\u9884\u6d4b\uff1a\u5c3d\u7ba1\u4fee\u9970\u5df2\u6709\u6548\u7ea0\u6b63\uff0c\u8f93\u51fa\u4ecd\u5f02\u5e38\uff1b\u9002\u5e94\u6027\u89e3\u91ca\u9884\u6d4b\u7ea0\u6b63\u540e\u8f93\u51fa\u8fdb\u4e00\u6b65\u6076\u5316\u3002\",\n      \"readout\": \"\u5e72\u9884\u9776\u5411\u6027\u4e0e\u771f\u5b9e\u4fee\u9970\u786e\u8ba4\uff1b\u8f93\u51fa\u52a8\u529b\u5b66\u3001\u6838\u5b54\u7ec4\u5206\u3001\u8fd0\u8f93\u56e0\u5b50\u5b9a\u4f4d\u3001\u4e0a\u6e38\u75c5\u7406\u4ee5\u53ca\u8f6c\u5f55\u548c RNA \u7a33\u5b9a\u6027\u3002\"\n    },\n    {\n      \"comparison\": \"\u5728\u53ef\u4fdd\u6301\u540c\u4e00\u75be\u75c5\u76f8\u5173\u80cc\u666f\u7684\u7ea0\u6b63\u6761\u4ef6\u4e2d\uff0c\u91cd\u65b0\u65bd\u52a0\u5df2\u5b9e\u6d4b\u5f02\u5e38\u4fee\u9970\u6a21\u5f0f\u4e0e\u7ef4\u6301\u57fa\u7ebf\u4fee\u9970\u72b6\u6001\u6bd4\u8f83\u3002\",\n      \"claim_prediction\": \"\u5728\u86cb\u767d\u91cf\u548c\u5b9a\u4f4d\u5339\u914d\u4e14\u65e0\u65b0\u589e\u975e\u7279\u5f02\u635f\u4f24\u65f6\uff0c\u91cd\u65b0\u65bd\u52a0\u5f02\u5e38\u4fee\u9970\u5e94\u518d\u6b21\u5ef6\u957f\u6838\u5b54\u505c\u7559\u5e76\u964d\u4f4e\u80de\u8d28\u5230\u8fbe\u901a\u91cf\u3002\",\n      \"alternative_prediction\": \"\u82e5\u539f\u7ea0\u6b63\u6548\u5e94\u6765\u81ea\u8131\u9776\u4fdd\u62a4\u3001\u8868\u8fbe\u91cf\u6216\u5b9a\u4f4d\u53d8\u5316\uff0c\u5355\u72ec\u91cd\u73b0\u771f\u5b9e\u4fee\u9970\u6a21\u5f0f\u4e0d\u5e94\u7a33\u5b9a\u5730\u91cd\u73b0\u91ca\u653e\u969c\u788d\u3002\",\n      \"readout\": \"\u771f\u5b9e\u4fee\u9970\u6a21\u5f0f\u3001\u76ee\u6807\u86cb\u767d\u91cf\u548c\u5b9a\u4f4d\u3001\u6210\u719f mRNP \u91ca\u653e\u52a8\u529b\u5b66\u53ca\u5373\u65f6\u635f\u4f24\u8bfb\u6570\uff1b\u4e0d\u4ee5\u78f7\u9178\u6a21\u62df\u5355\u72ec\u66ff\u4ee3\u771f\u5b9e\u4fee\u9970\u786e\u8ba4\u3002\"\n    },\n    {\n      \"comparison\": \"\u75be\u75c5\u76f8\u5173\u6761\u4ef6\u4e0b\uff0c\u5206\u522b\u6bd4\u8f83\u6210\u719f mRNP \u7684\u6838\u5b54\u5230\u8fbe\u4e0e\u5230\u8fbe\u540e\u7684\u91ca\u653e\u3002\",\n      \"claim_prediction\": \"\u5230\u8fbe\u6838\u5b54\u7684\u6210\u719f mRNP \u589e\u52a0\u505c\u7559\u4e14\u80de\u8d28\u51fa\u73b0\u51cf\u6162\uff1b\u5355\u7eaf\u8f6c\u5f55\u6216\u6210\u719f\u7a0b\u5ea6\u6539\u53d8\u4e0d\u8db3\u4ee5\u89e3\u91ca\u8fd9\u4e00\u9636\u6bb5\u7279\u5f02\u6027\u53d8\u5316\u3002\",\n      \"alternative_prediction\": \"\u6210\u719f\u6216\u62db\u52df\u969c\u788d\u89e3\u91ca\u9884\u6d4b\u6838\u5b54\u5230\u8fbe\u51cf\u5c11\uff0c\u6216 RNA \u4e3b\u8981\u6ede\u7559\u5728\u8fdc\u79bb\u6838\u5b54\u7684\u4f4d\u7f6e\uff0c\u800c\u975e\u5230\u8fbe\u540e\u7684\u505c\u7559\u9009\u62e9\u6027\u5ef6\u957f\u3002\",\n      \"readout\": \"\u80fd\u533a\u5206\u6210\u719f\u4e0e\u672a\u6210\u719f RNA \u7684\u68c0\u6d4b\u3001\u7a7a\u95f4\u5b9a\u4f4d\u53ca\u5206\u9636\u6bb5\u52a8\u529b\u5b66\uff0c\u5e76\u540c\u6b65\u68c0\u67e5\u8f6c\u5f55\u3001\u52a0\u5de5\u548c\u964d\u89e3\u3002\"\n    },\n    {\n      \"comparison\": \"\u6709\u6548\u4e14\u53ca\u65f6\u7684\u4fee\u9970\u7ea0\u6b63\u4e0e\u5047\u5e72\u9884\u5728\u65e9\u671f\u8f93\u51fa\u548c\u540e\u671f\u635f\u4f24\u4e0a\u7684\u6bd4\u8f83\u3002\",\n      \"claim_prediction\": \"\u5148\u51fa\u73b0\u8f93\u51fa\u6539\u5584\uff0c\u518d\u51fa\u73b0\u90e8\u5206\u540e\u671f\u635f\u4f24\u51cf\u8f7b\uff1b\u5728\u53ef\u5b9e\u65bd\u72ec\u7acb\u4e2d\u4ecb\u68c0\u9a8c\u65f6\uff0c\u963b\u65ad\u5df2\u6062\u590d\u7684\u8f93\u51fa\u5e94\u524a\u5f31\u8fd9\u90e8\u5206\u4fdd\u62a4\u3002\",\n      \"alternative_prediction\": \"\u8f93\u51fa\u4e0e\u635f\u4f24\u8131\u8026\u89e3\u91ca\u9884\u6d4b\u8f93\u51fa\u53ef\u6062\u590d\u4f46\u540e\u671f\u635f\u4f24\u4e0d\u53d8\uff1b\u5e72\u9884\u76f4\u63a5\u4fdd\u62a4\u89e3\u91ca\u9884\u6d4b\u4fdd\u62a4\u4e0d\u4f9d\u8d56\u8f93\u51fa\u6062\u590d\u3002\",\n      \"readout\": \"\u65f6\u95f4\u5206\u79bb\u7684\u8f93\u51fa\u901a\u91cf\u4e0e\u591a\u7ef4\u635f\u4f24\u8bfb\u6570\u3001\u5e72\u9884\u81ea\u8eab\u6bd2\u6027\uff0c\u4ee5\u53ca\u72ec\u7acb\u8f93\u51fa\u64cd\u7eb5\u7684\u9776\u5411\u6027\u548c\u76f4\u63a5\u635f\u4f24\u6548\u5e94\u3002\"\n    }\n  ],\n  \"falsification_conditions\": [\n    \"\u5728\u9009\u5b9a\u60c5\u5883\u4e2d\uff0c\u82e5\u771f\u5b9e\u78f7\u9178\u5316\u68c0\u6d4b\u7684\u8986\u76d6\u3001\u7075\u654f\u5ea6\u3001\u6837\u54c1\u8d28\u91cf\u53ca\u4e30\u5ea6\u6821\u6b63\u5747\u6709\u6548\uff0c\u4e14\u8de8\u6240\u5b9a\u4e49\u75be\u75c5\u76f8\u5173\u65f6\u6bb5\u7684\u7ed3\u679c\u80fd\u591f\u6392\u9664\u9884\u5148\u89c4\u5b9a\u7684\u6709\u610f\u4e49\u6301\u7eed\u5347\u9ad8\uff0c\u5219\u672c\u5019\u9009\u7684\u524d\u63d0\u5728\u8be5\u60c5\u5883\u4e2d\u4e0d\u6210\u7acb\uff1b\u8fd9\u4e0d\u7b49\u4e8e\u6240\u6709 ALS \u60c5\u5883\u5747\u65e0\u6838\u5b54\u86cb\u767d\u78f7\u9178\u5316\u53d8\u5316\u3002\",\n    \"\u82e5\u65f6\u95f4\u5206\u8fa8\u7387\u8db3\u4ee5\u533a\u5206\u4e8b\u4ef6\uff0c\u591a\u4e2a\u72ec\u7acb\u635f\u4f24\u6307\u6807\u5747\u5148\u4e8e\u4fee\u9970\u53d8\u5316\uff0c\u4e14\u4e0d\u5b58\u5728\u5df2\u88ab\u6d4b\u91cf\u9057\u6f0f\u7684\u65e9\u671f\u4fee\u9970\u7a97\u53e3\uff0c\u5219\u5426\u5b9a\u672c\u5019\u9009\u6240\u4e3b\u5f20\u7684\u635f\u4f24\u524d\u91ca\u653e\u673a\u5236\u3002\",\n    \"\u82e5\u5728\u53ef\u9006\u3001\u635f\u4f24\u524d\u7a97\u53e3\u5df2\u5145\u5206\u4e14\u9009\u62e9\u6027\u5730\u6062\u590d\u771f\u5b9e\u4fee\u9970\u57fa\u7ebf\uff0c\u68c0\u6d4b\u7cfb\u7edf\u6709\u80fd\u529b\u8bc6\u522b\u8f93\u51fa\u6539\u53d8\uff0c\u800c\u7ed3\u679c\u533a\u95f4\u6392\u9664\u9884\u5148\u89c4\u5b9a\u7684\u6709\u610f\u4e49\u91ca\u653e\u6216\u8f93\u51fa\u6539\u5584\uff0c\u5219\u5426\u5b9a\u8be5\u4fee\u9970\u5728\u8be5\u60c5\u5883\u4e2d\u901a\u8fc7\u6b64\u8def\u5f84\u4ea7\u751f\u4f5c\u7528\uff1b\u4e0d\u80fd\u4ec5\u51ed\u7edf\u8ba1\u4e0d\u663e\u8457\u4e0b\u7ed3\u8bba\u3002\",\n    \"\u82e5\u6709\u6548\u7684\u9636\u6bb5\u5206\u8fa8\u6d4b\u91cf\u663e\u793a\u6838\u5b54\u5230\u8fbe\u540e\u7684\u505c\u7559\u548c\u91ca\u653e\u6b63\u5e38\uff0c\u5f02\u5e38\u5b8c\u5168\u7531 RNA \u6210\u719f\u6216\u6838\u5b54\u62db\u52df\u51cf\u5c11\u89e3\u91ca\uff0c\u5219\u5426\u5b9a\u672c\u5019\u9009\u7684\u91ca\u653e\u9636\u6bb5\u673a\u5236\uff0c\u5373\u4f7f\u4ecd\u5b58\u5728\u5176\u4ed6\u78f7\u9178\u5316\u76f8\u5173\u673a\u5236\u3002\",\n    \"\u82e5\u9009\u62e9\u6027\u7ea0\u6b63\u5f02\u5e38\u4fee\u9970\u5728\u6392\u9664\u8131\u9776\u3001\u5242\u91cf\u548c\u5b9a\u4f4d\u6548\u5e94\u540e\u7a33\u5b9a\u52a0\u91cd\u8f93\u51fa\u969c\u788d\uff0c\u5219\u7ed3\u679c\u652f\u6301\u9002\u5e94\u6027\u89e3\u91ca\u5e76\u53cd\u5bf9\u672c\u5019\u9009\u7684\u4f5c\u7528\u65b9\u5411\u3002\",\n    \"\u82e5\u5e72\u9884\u8db3\u591f\u65e9\u3001\u8f93\u51fa\u6539\u5584\u5145\u5206\u4e14\u6301\u7eed\u3001\u540e\u671f\u635f\u4f24\u6d4b\u91cf\u6709\u6548\uff0c\u800c\u7ed3\u679c\u80fd\u591f\u6392\u9664\u6709\u610f\u4e49\u7684\u635f\u4f24\u51cf\u8f7b\uff0c\u5e76\u4e14\u72ec\u7acb\u8f93\u51fa\u7ea0\u6b63\u5f97\u5230\u4e00\u81f4\u7ed3\u679c\uff0c\u5219\u5426\u5b9a\u672c\u5019\u9009\u4e2d\u7684\u8f93\u51fa\u969c\u788d\u53c2\u4e0e\u635f\u4f24\u8fd9\u4e00\u6865\u6881\u3002\"\n  ],\n  \"validation_concept\": {\n    \"setting\": \"\u5728\u5c1a\u672a\u9884\u9009\u7684 ALS \u76f8\u5173\u975e\u4e34\u5e8a\u7814\u7a76\u60c5\u5883\u4e2d\uff0c\u5148\u786e\u8ba4\u4e00\u79cd\u6838\u5b54\u86cb\u767d\u81ea\u8eab\u7684\u6301\u7eed\u5f02\u5e38\u78f7\u9178\u5316\uff0c\u518d\u56fa\u5b9a\u8be5\u5bf9\u8c61\u68c0\u9a8c\u91ca\u653e\u9636\u6bb5\u673a\u5236\u3002\u6240\u4f9b\u8d44\u6599\u5c1a\u4e0d\u80fd\u4fdd\u8bc1\u4efb\u4f55\u7279\u5b9a\u6a21\u578b\u3001\u5e72\u9884\u5de5\u5177\u6216\u6d4b\u91cf\u7ec4\u5408\u53ef\u884c\u3002\",\n    \"comparison\": \"\u8bbe\u7f6e\u5339\u914d\u57fa\u7ebf\u4e0e\u75be\u75c5\u76f8\u5173\u6761\u4ef6\uff1b\u5728\u76f8\u540c\u75be\u75c5\u76f8\u5173\u80cc\u666f\u5185\u6bd4\u8f83\u635f\u4f24\u524d\u4fee\u9970\u7ea0\u6b63\u4e0e\u5047\u5e72\u9884\uff0c\u5e76\u5728\u6280\u672f\u6761\u4ef6\u5141\u8bb8\u65f6\u6bd4\u8f83\u7ea0\u6b63\u540e\u91cd\u65b0\u65bd\u52a0\u5f02\u5e38\u4fee\u9970\u3002\u5404\u6bd4\u8f83\u4f7f\u7528\u53ef\u5bf9\u5e94\u7684\u65f6\u95f4\u7a97\uff0c\u4e0d\u5c06\u4e0d\u540c\u7ec6\u80de\u7c7b\u578b\u6216\u4e0d\u540c\u8fd0\u8f93\u7ec8\u70b9\u76f8\u4e92\u66ff\u4ee3\u3002\",\n    \"intervention_and_measurement\": \"\u5148\u4ee5\u76f4\u63a5\u4fee\u9970\u9274\u5b9a\u548c\u72ec\u7acb\u6838\u5bf9\u533a\u5206\u78f7\u9178\u5316\u3001\u4e30\u5ea6\u53ca\u5b9a\u4f4d\u3002\u4ec5\u5728\u83b7\u5f97\u5e76\u9a8c\u8bc1\u4fee\u9970\u9009\u62e9\u6027\u624b\u6bb5\u540e\u5b9e\u65bd\u7ea0\u6b63\uff1b\u82e5\u53ea\u80fd\u83b7\u5f97\u86cb\u767d\u8017\u51cf\u6216\u5e7f\u6cdb\u901a\u8def\u6291\u5236\uff0c\u5219\u4e0d\u8db3\u4ee5\u5b8c\u6210\u5173\u952e\u56e0\u679c\u68c0\u9a8c\u3002\u8054\u5408\u6d4b\u91cf\u6210\u719f RNA \u7684\u6838\u5b54\u5230\u8fbe\u3001\u505c\u7559\u3001\u80de\u8d28\u51fa\u73b0\u548c\u603b\u4f53\u8f93\u51fa\uff0c\u53e6\u6d4b\u8f6c\u5f55\u3001\u52a0\u5de5\u3001\u964d\u89e3\u3001\u6838\u5b54\u7ec4\u5206\u53ca\u635f\u4f24\u3002\u82e5\u91c7\u7528\u4f4d\u70b9\u66ff\u6362\uff0c\u53ea\u5c06\u5176\u4f5c\u4e3a\u8f85\u52a9\uff0c\u5e76\u6838\u67e5\u4e0e\u771f\u5b9e\u4fee\u9970\u7684\u4e00\u81f4\u6027\u3002\u5177\u4f53\u5de5\u5177\u3001\u53c2\u6570\u3001\u65f6\u95f4\u548c\u6548\u5e94\u5224\u636e\u987b\u7531\u540e\u7eed\u65b9\u6cd5\u5de5\u4f5c\u786e\u5b9a\uff0c\u4e0d\u7531\u5f53\u524d\u6458\u8981\u5916\u63a8\u3002\",\n    \"controls\": \"\u5305\u62ec\u5339\u914d\u5047\u5e72\u9884\u3001\u68c0\u6d4b\u7279\u5f02\u6027\u4e0e\u6837\u54c1\u5904\u7406\u63a7\u5236\u3001\u86cb\u767d\u8868\u8fbe\u548c\u5b9a\u4f4d\u5339\u914d\u3001\u6838\u5b54\u7ec4\u5206\u4e0e\u6838\u819c\u72b6\u6001\u68c0\u67e5\u3001RNA \u6210\u719f\u548c\u7a33\u5b9a\u6027\u63a7\u5236\u3001\u7ec6\u80de\u7ec4\u6210\u53ca\u5b58\u6d3b\u504f\u5dee\u68c0\u67e5\u3001\u5e72\u9884\u81ea\u8eab\u6bd2\u6027\u548c\u4e0a\u6e38\u75c5\u7406\u76d1\u6d4b\u3002\u4ee5\u72ec\u7acb\u5e72\u9884\u6216\u53ef\u9a8c\u8bc1\u7684\u6062\u590d\u6bd4\u8f83\u68c0\u9a8c\u8131\u9776\u5f71\u54cd\uff1b\u86cb\u767d\u6838\u8f93\u5165\u3001XPO1 \u5b9a\u4f4d\u6216\u6838\u5706\u5ea6\u4ec5\u4f5c\u5404\u81ea\u7ec8\u70b9\uff0c\u4e0d\u80fd\u66ff\u4ee3 mRNA \u8f93\u51fa\u3002\u9884\u5148\u5b9a\u4e49\u80fd\u6392\u9664\u6709\u610f\u4e49\u6548\u5e94\u7684\u6d4b\u91cf\u7cbe\u5ea6\u4e0e\u5224\u65ad\u8fb9\u754c\u3002\"\n  },\n  \"limitations\": [\n    \"\u8fd9\u662f\u4e00\u6b21\u6761\u4ef6\u6027\u5047\u8bf4\u5f62\u6210\uff0c\u5c1a\u672a\u8fdb\u884c\u79d1\u5b66\u9a8c\u8bc1\u3001\u5b9e\u9a8c\u3001\u989d\u5916\u68c0\u7d22\u6216\u6e90\u6570\u636e\u6838\u9a8c\uff1b\u4e0d\u6784\u6210\u60a3\u8005\u6cbb\u7597\u65b9\u6848\u3001\u5b9e\u9a8c\u53ef\u884c\u6027\u4fdd\u8bc1\u6216\u65b0\u9896\u6027\u8bc1\u660e\u3002\",\n    \"\u6838\u5fc3\u524d\u63d0\u7f3a\u53e3\u4fdd\u7559\uff1a\u6240\u4f9b\u5df2\u8bfb ALS \u89c6\u56fe\u672a\u62a5\u544a\u6838\u5b54\u86cb\u767d\u81ea\u8eab\u7684\u78f7\u9178\u5316\u6d4b\u91cf\u3002\u4fee\u9970\u662f\u5426\u5b58\u5728\u3001\u65b9\u5411\u3001\u4f4d\u70b9\u3001\u7ec6\u80de\u7c7b\u578b\u4f9d\u8d56\u6027\u3001\u65f6\u5e8f\u3001\u9009\u62e9\u6027\u53ef\u64cd\u7eb5\u6027\u53ca\u635f\u4f24\u8d21\u732e\u5747\u672a\u77e5\u3002\",\n    \"\u6838\u5b54\u91ca\u653e\u5ef6\u8fdf\u662f\u672c\u5019\u9009\u7684\u65b0\u731c\u60f3\uff0c\u4e0d\u662f\u4efb\u4f55\u6765\u6e90\u7684\u7ed3\u8bba\uff1b\u5f53\u524d\u6ca1\u6709\u6307\u5b9a\u5176\u7ed3\u6784\u754c\u9762\u3001\u76f4\u63a5\u6fc0\u9176\u3001\u78f7\u9178\u9176\u6216\u5177\u4f53\u4f4d\u70b9\u3002\",\n    \"\u8bbf\u95ee\u8303\u56f4\u4e3a\uff1aANXA11 \u5b8c\u6574\u53d6\u5f97\u7684 Abstract\u3001Highlights\u3001In Brief \u6587\u672c [0,2746]\uff1bSOD1\u3001TPR\u3001SUN1 \u5b8c\u6574\u53d6\u5f97\u7684\u6458\u8981\u5206\u522b\u4e3a [0,1714]\u3001[0,2097]\u3001[0,1188]\u3002\u8fd9\u4e9b\u5747\u4e0d\u7b49\u4e8e\u5168\u6587\u9605\u8bfb\u3002\",\n    \"TDP-43 \u53ea\u8bbf\u95ee\u539f\u59cb 125363 \u5b57\u7b26\u6587\u672c\u4e2d\u7684 [33770,41370]\uff0c\u5176\u4f59 [0,33770] \u548c [41370